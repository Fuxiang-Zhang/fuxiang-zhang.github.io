# Local development only. Copy to .env; the local server reads it via node --env-file-if-exists.
# Without OPENAI_API_KEY the local server returns the labelled mock reply.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# selective sends a compact index and loads paper details on demand; full restores all content.
CHAT_CONTEXT_MODE=selective
